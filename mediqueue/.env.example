# MediQueue Environment Configuration
# Database credentials and service ports

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_DATABASE=mediqueue_db
MYSQL_USER=mediqueue
MYSQL_PASSWORD=mediqueue_pass
MYSQL_ROOT_PASSWORD=mediqueue_root_pass

# MongoDB
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DATABASE=mediqueue_mongo
MONGO_USER=
MONGO_PASSWORD=

# Hadoop / Hive
HDFS_NAMENODE_URL=hdfs://localhost:9000
HDFS_RAW_DIR=/mediqueue/raw
HDFS_PROCESSED_DIR=/mediqueue/processed
HDFS_OUTPUT_DIR=/mediqueue/output
HIVE_SERVER2_URL=jdbc:hive2://localhost:10000/default

# Pipeline Configuration
DATA_GENERATOR_VISITS=150000
DATA_GENERATOR_DAYS=90
DATA_GENERATOR_SEED=42

# Dashboard
DASHBOARD_PORT=5000
DASHBOARD_DEBUG=False
